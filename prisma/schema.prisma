generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminStatus {
  ACTIVE
  DISABLED
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  OFFLINE
}

enum AssetType {
  PDF
  IMAGE
  EXTERNAL_LINK
}

enum AssetOpenMode {
  SAME_TAB
  NEW_TAB
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  FAILED
  ROLLED_BACK
}

model AdminUser {
  id              String              @id @default(cuid())
  email           String              @unique
  displayName     String
  passwordHash    String
  status          AdminStatus         @default(ACTIVE)
  lastLoginAt     DateTime?
  deletedAt       DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  modulesCreated  InformationModule[] @relation("ModuleCreator")
  modulesUpdated  InformationModule[] @relation("ModuleUpdater")
  cardsCreated    ReportCard[]        @relation("CardCreator")
  cardsUpdated    ReportCard[]        @relation("CardUpdater")
  assetsCreated   ReportAsset[]       @relation("AssetCreator")
  assetsUpdated   ReportAsset[]       @relation("AssetUpdater")
  publications    PublishVersion[]    @relation("Publisher")
  auditLogs       AuditLog[]          @relation("AuditOperator")
  settingsCreated SiteSetting[]       @relation("SettingCreator")
  settingsUpdated SiteSetting[]       @relation("SettingUpdater")
  sessions        AdminSession[]
  loginAttempts   AdminLoginAttempt[]
}

model AdminSession {
  id         String    @id @default(cuid())
  adminId    String
  tokenDigest String   @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  admin      AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, revokedAt, expiresAt])
}

model AdminLoginAttempt {
  id             String     @id @default(cuid())
  adminId        String?
  identifierHash String
  ipHash         String?
  success        Boolean    @default(false)
  createdAt      DateTime   @default(now())
  admin          AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([identifierHash, success, createdAt])
  @@index([ipHash, success, createdAt])
}

model InformationModule {
  id            String        @id @default(cuid())
  slug          String        @unique
  title         String
  description   String?
  sortOrder     Int           @default(0)
  contentStatus ContentStatus @default(DRAFT)
  isOnline      Boolean       @default(false)
  publishedAt   DateTime?
  offlineAt     DateTime?
  deletedAt     DateTime?
  createdById   String
  updatedById   String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  createdBy     AdminUser     @relation("ModuleCreator", fields: [createdById], references: [id])
  updatedBy     AdminUser     @relation("ModuleUpdater", fields: [updatedById], references: [id])
  cards         ReportCard[]

  @@index([contentStatus, isOnline, deletedAt, sortOrder])
}

model ReportCard {
  id            String            @id @default(cuid())
  moduleId      String
  title         String
  description   String?
  buttonText    String            @default("查看资料")
  footerNote    String?
  sortOrder     Int               @default(0)
  contentStatus ContentStatus     @default(DRAFT)
  isOnline      Boolean           @default(false)
  publishedAt   DateTime?
  offlineAt     DateTime?
  deletedAt     DateTime?
  createdById   String
  updatedById   String
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  module        InformationModule @relation(fields: [moduleId], references: [id], onDelete: Restrict)
  createdBy     AdminUser         @relation("CardCreator", fields: [createdById], references: [id])
  updatedBy     AdminUser         @relation("CardUpdater", fields: [updatedById], references: [id])
  assets        ReportAsset[]

  @@index([moduleId, contentStatus, isOnline, deletedAt, sortOrder])
}

model ReportAsset {
  id            String        @id @default(cuid())
  reportCardId  String
  title         String
  description   String?
  assetType     AssetType
  openMode      AssetOpenMode @default(SAME_TAB)
  storageKey    String?
  externalUrl   String?
  mimeType      String?
  byteSize      BigInt?
  sortOrder     Int           @default(0)
  contentStatus ContentStatus @default(DRAFT)
  isOnline      Boolean       @default(false)
  publishedAt   DateTime?
  offlineAt     DateTime?
  deletedAt     DateTime?
  createdById   String
  updatedById   String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  reportCard    ReportCard    @relation(fields: [reportCardId], references: [id], onDelete: Restrict)
  createdBy     AdminUser     @relation("AssetCreator", fields: [createdById], references: [id])
  updatedBy     AdminUser     @relation("AssetUpdater", fields: [updatedById], references: [id])

  @@index([reportCardId, contentStatus, isOnline, deletedAt, sortOrder])
}

model PublishVersion {
  id              String          @id @default(cuid())
  versionNumber   Int             @unique
  status          PublishStatus   @default(DRAFT)
  snapshot        Json
  note            String?
  publishedAt     DateTime?
  publishedById   String
  rollbackFromId  String?
  createdAt       DateTime        @default(now())
  publishedBy     AdminUser       @relation("Publisher", fields: [publishedById], references: [id])
  rollbackFrom    PublishVersion? @relation("VersionRollback", fields: [rollbackFromId], references: [id], onDelete: SetNull)
  rollbacks       PublishVersion[] @relation("VersionRollback")
}

model AuditLog {
  id               String    @id @default(cuid())
  operatorId       String
  action           String
  targetType       String
  targetId         String?
  publishVersionId String?
  detail           Json?
  ipAddress        String?
  createdAt        DateTime  @default(now())
  operator         AdminUser @relation("AuditOperator", fields: [operatorId], references: [id])

  @@index([targetType, targetId, createdAt])
  @@index([operatorId, createdAt])
}

model SiteSetting {
  id            String        @id @default(cuid())
  key           String        @unique
  name          String
  description   String?
  value         Json
  sortOrder     Int           @default(0)
  contentStatus ContentStatus @default(DRAFT)
  isOnline      Boolean       @default(false)
  publishedAt   DateTime?
  offlineAt     DateTime?
  deletedAt     DateTime?
  createdById   String
  updatedById   String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  createdBy     AdminUser     @relation("SettingCreator", fields: [createdById], references: [id])
  updatedBy     AdminUser     @relation("SettingUpdater", fields: [updatedById], references: [id])

  @@index([contentStatus, isOnline, deletedAt, sortOrder])
}
